# Copy this file to ".env" (local) or set the same names in your hosting dashboard (production).
# Values are baked in at BUILD time. Never put secrets here – everything VITE_* is public.

# Base URL of the backend API (CloudMirror application server). Leave empty until it exists.
VITE_API_BASE=
VITE_CONTACT_PATH=/v1/contact

# TODO: replace with the real address
VITE_CONTACT_EMAIL=hello@your-domain.com

# Bump when the privacy text changes; stored with every consent record.
VITE_CONSENT_VERSION=2026-10-v1
